NODE_ENV=test
PORT=8000

# Must be a dedicated database (name should include "test") — never point at em-school / production
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/em-school-test?sslmode=require&uselibpqcompat=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

SECRET_KEY=integration-test-secret-key-min-16-chars
JWT_SECRET=integration-test-secret-key-min-16-chars

CORS_ORIGIN=http://localhost:8081
FRONTEND_HOST=http://localhost:8081
PUBLIC_API_URL=http://localhost:8000

CLOUDINARY_URL=cloudinary://000000000000000:dummy-secret@dummy
REDIS_URL=redis://127.0.0.1:6379

FIRST_SUPERUSER=super@test.local
FIRST_SUPERUSER_PASSWORD=test-super-password
