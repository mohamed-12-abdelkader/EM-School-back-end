NODE_ENV=development
PORT=8000

# Expo web / mobile origins
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000
FRONTEND_HOST=http://localhost:8081
PUBLIC_API_URL=http://localhost:8000

SECRET_KEY=replace-with-a-long-random-secret-key
JWT_SECRET=replace-with-a-long-random-secret-key
SUPABASE_STORAGE_BUCKET=admissions-docs
HARDWARE_WEBHOOK_SECRET=replace-hmac-secret
EXPO_ACCESS_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Supabase project (Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase Postgres — prefer Session pooler (IPv4). Direct db.* host can be IPv6-only.
# Settings → Database → Connection string → URI (Session mode)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Redis for BullMQ (Upstash / Redis Cloud / local Redis — Docker is not used)
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST:6379

FIRST_SUPERUSER=admin@emschool.local
FIRST_SUPERUSER_PASSWORD=admin123456

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional: HMAC secret for /api/v1/sis/webhooks/hardware/attendance
HARDWARE_WEBHOOK_SECRET=
